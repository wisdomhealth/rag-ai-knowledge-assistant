OPENAI_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials.json
GOOGLE_OAUTH_TOKEN_FILE=token.json

OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# New directory and collection: never silently replace existing knowledge data.
VECTOR_STORE_DIR=data/chroma_v2
CHROMA_COLLECTION=google_drive_llama_v1
CHUNK_SIZE=768
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_TOP_K=5
CONTEXT_MAX_CHARS=16000
HISTORY_MAX_TURNS=6
HISTORY_MAX_CHARS=8000
REQUEST_TIMEOUT=90
MAX_OUTPUT_TOKENS=2000

SESSION_DB=data/sessions.sqlite3
SESSION_TTL_SECONDS=604800
# Set true behind HTTPS. HTTP local development requires false.
COOKIE_SECURE=false
# Configure both to protect private knowledge on a shared network.
API_BASIC_AUTH_USERNAME=
API_BASIC_AUTH_PASSWORD=
